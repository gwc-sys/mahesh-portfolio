APP_ENV=development
APP_NAME=GitHub Task Tracker
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/github_task_tracker
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
COOKIE_NAME=task_tracker_session
COOKIE_DOMAIN=
ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/github/callback
